# ============================================================
#  Sorteo NovaLink — Variables de entorno
#  Copia este archivo a `.env` y completa los valores.
# ============================================================

# Contraseña de acceso al backoffice (/admin).
# Usa una contraseña fuerte.
ADMIN_PASSWORD=cambia-esta-contrasena

# Secreto para firmar la cookie de sesión del administrador.
# Genera un valor aleatorio largo, por ejemplo: `openssl rand -hex 24`
SESSION_SECRET=cambia-este-secreto-aleatorio

# --- Opcionales (la app usa estos valores por defecto si no se definen) ---

# Ruta del archivo de base de datos SQLite.
# Por defecto: ./data/sorteo.db
DATABASE_PATH=/data/sorteo.db

# Carpeta donde se guardan los comprobantes de transferencia subidos.
# Por defecto: ./data/uploads
UPLOAD_DIR=/data/uploads
